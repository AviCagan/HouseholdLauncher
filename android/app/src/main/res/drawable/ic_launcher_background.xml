<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive icon's background layer.

  A gradient shape rather than the flat @color it used to be, so the launcher
  icon matches the tile the rest of the app is built around. Android composites
  this under mipmap/ic_launcher_foreground and then applies whatever mask the
  device uses, so this must be full-bleed with no corner rounding of its own —
  the system does the rounding, and doing it here too leaves dark corners
  inside the mask.

  Angles are quantised to 45° because that is all <gradient> accepts; the
  135° here is the closest thing to the top-left-to-bottom-right sweep the
  SVG source uses.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="#9B7BFF"
        android:centerColor="#6A45E8"
        android:endColor="#3A1E9E"
        android:type="linear" />
</shape>
