<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The site's own links — above all the QR codes on Inventory
                 labels — can open in the app instead of the browser. Not
                 auto-verified (that needs a file at the root of the domain,
                 which a project page can't serve), so Android asks once, or
                 it's switched on under App info → Open by default. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="avicagan.github.io" android:pathPrefix="/HouseholdLauncher" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Location, for "Use this phone's location" in the Calendar (sunset and
      nightfall where you live). Asked for only when that button is tapped.
      Both are declared because the web view asks for both; on Android 12 and
      later the person can still choose "approximate", which is all it needs.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Lets the app see a camera app. Since Android 11 an app can't find
         another app's activities unless it says which it needs, and without
         this Capacitor's WebView finds no camera for a photo input marked
         `capture` and quietly opens the gallery instead — the Camera buttons
         in Inventory, and its page scanner, would never reach the camera. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!-- Notifications on Android 13+. Without this the launcher can hold a
         valid FCM token and still never show anything. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
